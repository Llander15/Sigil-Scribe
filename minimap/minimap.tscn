[sub_resource type="Shader" id=6]
code = "shader_type canvas_item;

uniform vec4 border_color : hint_color = vec4(1.0, 1.0, 1.0, 1.0); // White border
uniform float border_width : hint_range(0.0, 0.1) = 0.01; // Thickness

void fragment() {
    float dist = distance(UV, vec2(0.5));
    vec4 color = texture(TEXTURE, UV);
    
    // Create the circle mask
    float circle = step(dist, 0.5);
    
    // Create the border mask
    // If distance is between 0.49 and 0.5, color it as a border
    float border_mask = step(0.5 - border_width, dist) * step(dist, 0.5);
    
    // Apply the circle transparency
    color.a *= circle;
    
    // Mix the viewport color with the border color
    color.rgb = mix(color.rgb, border_color.rgb, border_mask);
    
    COLOR = color;
}"

[sub_resource type="ShaderMaterial" id=7]
shader = SubResource( 6 )
shader_param/border_color = Color( 1, 1, 1, 1 )
shader_param/border_width = 0.01

