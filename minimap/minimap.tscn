[gd_scene load_steps=4 format=2]

[ext_resource path="res://icon32.png" type="Texture" id=1]

[sub_resource type="Shader" id=6]
code = "shader_type canvas_item;

uniform float corner_radius : hint_range(0.0, 100.0) = 8.0; // Corner radius in pixels (e.g., 8.0 or 16.0)
uniform float border_width : hint_range(0.0, 50.0) = 1.0;   // Border thickness in pixels
uniform vec4 border_color : hint_color = vec4(1.0, 1.0, 1.0, 1.0); // White border

// Signed distance field (SDF) function for a rounded box compatible with Godot 3.x
float sd_rounded_box(vec2 p, vec2 b, float r) {
    vec2 q = abs(p) - b + vec2(r);
    return min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0))) - r;
}

void fragment() {
    // Convert UV (0.0 to 1.0) into pixel coordinates centered at (0, 0)
    vec2 size = 1.0 / TEXTURE_PIXEL_SIZE;
    vec2 half_size = size * 0.5;
    vec2 p = (UV - vec2(0.5)) * size;

    // Signed distance to the rounded box boundary
    float dist = sd_rounded_box(p, half_size, corner_radius);

    vec4 color = texture(TEXTURE, UV);

    // Alpha mask for the rounded rectangle shape
    float alpha_mask = step(dist, 0.0);

    // Inner border mask
    float border_mask = step(-border_width, dist) * step(dist, 0.0);

    // Apply corner clipping
    color.a *= alpha_mask;

    // Apply border color
    color.rgb = mix(color.rgb, border_color.rgb, border_mask);

    COLOR = color;
}"

